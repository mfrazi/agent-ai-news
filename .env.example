# =======================================================
# AI Intelligence Agent Configuration
# =======================================================

# LLM Providers (Configure at least one)
# Preferred Provider: openrouter | gemini | openai | anthropic
# (leave empty to auto-detect from whichever API key below is set)
AGENT_LLM_PROVIDER=openrouter
AGENT_MODEL_NAME=anthropic/claude-sonnet-5

# Provider API Keys
OPENROUTER_API_KEY=
# GOOGLE_API_KEY also accepts the alias GEMINI_API_KEY
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter Provider Routing (Optional)
# Specify preferred underlying inference providers (e.g. Together, DeepInfra, Anthropic, Lepton)
# OPENROUTER_PROVIDER (singular) is accepted as an alias
OPENROUTER_PROVIDERS=
# Allow backup providers if preferred providers are unavailable (true / false)
OPENROUTER_ALLOW_FALLBACKS=true

# Search Tools
# Optional: If omitted, automatically falls back to DuckDuckGo Search
TAVILY_API_KEY=

# API Server
# Clients must send this in the X-API-Key header. If unset, `agent-ai-news serve` generates a
# temporary key at startup and prints it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Output Directory (reports are saved to its research/ and digests/ subfolders)
SITE_DOCS_DIR=site_docs

# Agent Runtime Limits (optional; defaults shown)
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# AGENT_RECURSION_LIMIT=200
# PROGRESS_HEARTBEAT_SECONDS=30
